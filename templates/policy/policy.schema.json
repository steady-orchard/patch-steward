{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "supported_behavior": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 16384
        },
        "environments": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 16384
          }
        },
        "platforms": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 16384
          }
        },
        "compatibility": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 16384
          }
        },
        "versions": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "supported": {
                "type": "boolean"
              },
              "branch": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384,
                "pattern": "^(?![-/])(?!.*(?:\\.\\.|\\/\\/))(?!.*[/.]$)[A-Za-z0-9._/-]+$"
              },
              "support_ends": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": ["version", "supported", "branch", "support_ends"],
            "additionalProperties": false
          }
        },
        "components": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "paths": {
                "maxItems": 1000,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 16384
                }
              }
            },
            "required": ["id", "paths"],
            "additionalProperties": false
          }
        },
        "documents": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "path": {
                "type": "string",
                "maxLength": 16384
              }
            },
            "required": ["id", "path"],
            "additionalProperties": false
          }
        },
        "decisions": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "path": {
                "type": "string",
                "maxLength": 16384
              }
            },
            "required": ["id", "path"],
            "additionalProperties": false
          }
        },
        "design_rules": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "rule": {
                "type": "string",
                "maxLength": 16384
              }
            },
            "required": ["id", "rule"],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "description",
        "environments",
        "platforms",
        "compatibility",
        "versions",
        "components",
        "documents",
        "decisions",
        "design_rules"
      ],
      "additionalProperties": false
    },
    "trusted_paths": {
      "type": "object",
      "properties": {
        "additional": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 16384
          }
        }
      },
      "required": ["additional"],
      "additionalProperties": false
    },
    "execution_sensitive_paths": {
      "type": "object",
      "properties": {
        "additional": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 16384
          }
        }
      },
      "required": ["additional"],
      "additionalProperties": false
    },
    "categories": {
      "type": "object",
      "properties": {
        "bugfix": {
          "type": "object",
          "properties": {
            "required_fields": {
              "maxItems": 1000,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "category",
                  "problem",
                  "benefit",
                  "intended-behavior",
                  "acceptance-criteria",
                  "linked-issue",
                  "regression-test",
                  "test-scaffolding",
                  "reproduction-command",
                  "expected-result",
                  "references"
                ]
              }
            },
            "linked_issue": {
              "type": "string",
              "enum": ["required", "optional"]
            },
            "references": {
              "type": "string",
              "enum": ["required", "optional"]
            },
            "reproduction": {
              "type": "string",
              "enum": ["required", "optional", "not-applicable"]
            },
            "regression_test": {
              "type": "string",
              "enum": ["required", "not-applicable"]
            }
          },
          "required": ["required_fields", "linked_issue", "references", "reproduction", "regression_test"],
          "additionalProperties": false
        },
        "feature": {
          "type": "object",
          "properties": {
            "required_fields": {
              "maxItems": 1000,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "category",
                  "problem",
                  "benefit",
                  "intended-behavior",
                  "acceptance-criteria",
                  "linked-issue",
                  "regression-test",
                  "test-scaffolding",
                  "reproduction-command",
                  "expected-result",
                  "references"
                ]
              }
            },
            "linked_issue": {
              "type": "string",
              "enum": ["required", "optional"]
            },
            "references": {
              "type": "string",
              "enum": ["required", "optional"]
            },
            "reproduction": {
              "type": "string",
              "enum": ["required", "optional", "not-applicable"]
            },
            "regression_test": {
              "type": "string",
              "enum": ["required", "not-applicable"]
            }
          },
          "required": ["required_fields", "linked_issue", "references", "reproduction", "regression_test"],
          "additionalProperties": false
        },
        "refactor": {
          "type": "object",
          "properties": {
            "required_fields": {
              "maxItems": 1000,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "category",
                  "problem",
                  "benefit",
                  "intended-behavior",
                  "acceptance-criteria",
                  "linked-issue",
                  "regression-test",
                  "test-scaffolding",
                  "reproduction-command",
                  "expected-result",
                  "references"
                ]
              }
            },
            "linked_issue": {
              "type": "string",
              "enum": ["required", "optional"]
            },
            "references": {
              "type": "string",
              "enum": ["required", "optional"]
            },
            "reproduction": {
              "type": "string",
              "enum": ["required", "optional", "not-applicable"]
            },
            "regression_test": {
              "type": "string",
              "enum": ["required", "not-applicable"]
            }
          },
          "required": ["required_fields", "linked_issue", "references", "reproduction", "regression_test"],
          "additionalProperties": false
        },
        "docs": {
          "type": "object",
          "properties": {
            "required_fields": {
              "maxItems": 1000,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "category",
                  "problem",
                  "benefit",
                  "intended-behavior",
                  "acceptance-criteria",
                  "linked-issue",
                  "regression-test",
                  "test-scaffolding",
                  "reproduction-command",
                  "expected-result",
                  "references"
                ]
              }
            },
            "linked_issue": {
              "type": "string",
              "enum": ["required", "optional"]
            },
            "references": {
              "type": "string",
              "enum": ["required", "optional"]
            },
            "reproduction": {
              "type": "string",
              "enum": ["required", "optional", "not-applicable"]
            },
            "regression_test": {
              "type": "string",
              "enum": ["required", "not-applicable"]
            }
          },
          "required": ["required_fields", "linked_issue", "references", "reproduction", "regression_test"],
          "additionalProperties": false
        },
        "chore": {
          "type": "object",
          "properties": {
            "required_fields": {
              "maxItems": 1000,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "category",
                  "problem",
                  "benefit",
                  "intended-behavior",
                  "acceptance-criteria",
                  "linked-issue",
                  "regression-test",
                  "test-scaffolding",
                  "reproduction-command",
                  "expected-result",
                  "references"
                ]
              }
            },
            "linked_issue": {
              "type": "string",
              "enum": ["required", "optional"]
            },
            "references": {
              "type": "string",
              "enum": ["required", "optional"]
            },
            "reproduction": {
              "type": "string",
              "enum": ["required", "optional", "not-applicable"]
            },
            "regression_test": {
              "type": "string",
              "enum": ["required", "not-applicable"]
            }
          },
          "required": ["required_fields", "linked_issue", "references", "reproduction", "regression_test"],
          "additionalProperties": false
        },
        "security": {
          "type": "object",
          "properties": {
            "required_fields": {
              "maxItems": 1000,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "category",
                  "problem",
                  "benefit",
                  "intended-behavior",
                  "acceptance-criteria",
                  "linked-issue",
                  "regression-test",
                  "test-scaffolding",
                  "reproduction-command",
                  "expected-result",
                  "references"
                ]
              }
            },
            "linked_issue": {
              "type": "string",
              "enum": ["required", "optional"]
            },
            "references": {
              "type": "string",
              "enum": ["required", "optional"]
            },
            "reproduction": {
              "type": "string",
              "enum": ["required", "optional", "not-applicable"]
            },
            "regression_test": {
              "type": "string",
              "enum": ["required", "not-applicable"]
            }
          },
          "required": ["required_fields", "linked_issue", "references", "reproduction", "regression_test"],
          "additionalProperties": false
        }
      },
      "required": ["bugfix", "feature", "refactor", "docs", "chore", "security"],
      "additionalProperties": false
    },
    "submission": {
      "type": "object",
      "properties": {
        "free_form": {
          "default": false,
          "type": "boolean"
        },
        "unrequested_change": {
          "default": "propose-first",
          "type": "string",
          "enum": ["propose-first", "triage"]
        },
        "issue_fields": {
          "type": "object",
          "properties": {
            "defect": {
              "maxItems": 1000,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "expected-behavior",
                  "authoritative-basis",
                  "actual-behavior",
                  "affected-version",
                  "reproduction-command",
                  "expected-result",
                  "proposed-scope",
                  "references",
                  "security-claim"
                ]
              }
            },
            "proposal": {
              "maxItems": 1000,
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["problem", "benefit", "existing-decision", "proposed-scope", "references"]
              }
            }
          },
          "required": ["defect", "proposal"],
          "additionalProperties": false
        },
        "reference_hosts": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["any-public", "allowlist"]
            },
            "allowlist": {
              "maxItems": 1000,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384,
                "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$"
              }
            }
          },
          "required": ["mode", "allowlist"],
          "additionalProperties": false
        },
        "attachments": {
          "type": "object",
          "properties": {
            "destinations": {
              "maxItems": 1000,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384,
                "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$"
              }
            },
            "formats": {
              "maxItems": 1000,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9]+(?:\\.[a-z0-9]+)*$"
              }
            }
          },
          "required": ["destinations", "formats"],
          "additionalProperties": false
        }
      },
      "required": ["issue_fields", "reference_hosts", "attachments"],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "commands": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "kind": {
                "type": "string",
                "enum": ["build", "test", "lint", "static-analysis"]
              },
              "run": {
                "minItems": 1,
                "maxItems": 1000,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 16384
                }
              },
              "working_directory": {
                "type": "string",
                "maxLength": 16384
              },
              "mandatory": {
                "type": "boolean"
              },
              "result_files": {
                "maxItems": 1000,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "maxLength": 16384
                    },
                    "format": {
                      "type": "string",
                      "enum": ["junit-xml"]
                    }
                  },
                  "required": ["path", "format"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["id", "kind", "run", "working_directory", "mandatory", "result_files"],
            "additionalProperties": false
          }
        },
        "platforms": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "os": {
                "type": "string",
                "enum": ["linux", "windows", "macos"]
              },
              "required": {
                "type": "boolean"
              },
              "source": {
                "type": "string",
                "enum": ["container", "ci-signal"]
              },
              "ci_workflow": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 16384
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "commands": {
                "minItems": 1,
                "maxItems": 1000,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                }
              }
            },
            "required": ["id", "os", "required", "source", "ci_workflow", "commands"],
            "additionalProperties": false
          }
        }
      },
      "required": ["commands", "platforms"],
      "additionalProperties": false
    },
    "runner": {
      "type": "object",
      "properties": {
        "image": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "const": "dockerfile"
                },
                "path": {
                  "type": "string",
                  "maxLength": 16384
                }
              },
              "required": ["source", "path"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "const": "registry"
                },
                "reference": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384,
                  "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*(?::[0-9]{1,5})?(?:\\/[a-z0-9]+(?:[._-][a-z0-9]+)*)*(?::[A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?(?:@sha256:[0-9a-f]{64})?$"
                }
              },
              "required": ["source", "reference"],
              "additionalProperties": false
            }
          ]
        },
        "network": {
          "default": "none",
          "type": "string",
          "const": "none"
        },
        "dependency_step": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "run": {
                  "minItems": 1,
                  "maxItems": 1000,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 16384
                  }
                },
                "working_directory": {
                  "type": "string",
                  "maxLength": 16384
                }
              },
              "required": ["run", "working_directory"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "resources": {
          "type": "object",
          "properties": {
            "cpus": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "memory_mb": {
              "type": "integer",
              "minimum": 512,
              "maximum": 14336
            },
            "pids": {
              "type": "integer",
              "minimum": 32,
              "maximum": 4096
            }
          },
          "required": ["cpus", "memory_mb", "pids"],
          "additionalProperties": false
        }
      },
      "required": ["image", "dependency_step", "resources"],
      "additionalProperties": false
    },
    "llm": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["copilot-sdk", "openai-compatible"]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "^[\\x21-\\x7e]+$"
        },
        "auth": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["github-token", "env"]
            }
          },
          "required": ["type"],
          "additionalProperties": false
        },
        "options": {
          "type": "object",
          "properties": {
            "base_url": {
              "type": "string",
              "maxLength": 16384
            }
          },
          "required": ["base_url"],
          "additionalProperties": false
        },
        "generation": {
          "type": "object",
          "properties": {
            "temperature": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["temperature"],
          "additionalProperties": false
        },
        "required_capabilities": {
          "type": "object",
          "properties": {
            "structured_output": {
              "type": "string",
              "enum": ["any", "native"]
            }
          },
          "required": ["structured_output"],
          "additionalProperties": false
        },
        "admission": {
          "default": "all",
          "type": "string",
          "enum": ["all", "maintainer-approved"]
        },
        "limits": {
          "type": "object",
          "properties": {
            "model_calls_per_run": {
              "type": "integer",
              "minimum": 1,
              "maximum": 150
            },
            "retries_per_call": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "repair_attempts_per_session": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "call_seconds": {
              "type": "integer",
              "minimum": 5,
              "maximum": 600
            },
            "daily_inference_runs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "ai_credits_per_run": {
              "type": "integer",
              "minimum": 30,
              "maximum": 1000
            },
            "tokens_per_run": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 2000000
            },
            "output_tokens_per_call": {
              "type": "integer",
              "minimum": 256,
              "maximum": 32768
            }
          },
          "required": [
            "model_calls_per_run",
            "retries_per_call",
            "repair_attempts_per_session",
            "call_seconds",
            "daily_inference_runs"
          ],
          "additionalProperties": false
        }
      },
      "required": ["provider", "model", "auth", "generation", "required_capabilities", "limits"],
      "additionalProperties": false
    },
    "stages": {
      "type": "object",
      "properties": {
        "continue_after_blocking": {
          "type": "boolean"
        },
        "per_category": {
          "type": "object",
          "properties": {
            "bugfix": {
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["fix-verification", "regression", "challenge"]
              }
            },
            "feature": {
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["fix-verification", "regression", "challenge"]
              }
            },
            "refactor": {
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["fix-verification", "regression", "challenge"]
              }
            },
            "docs": {
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["fix-verification", "regression", "challenge"]
              }
            },
            "chore": {
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["fix-verification", "regression", "challenge"]
              }
            },
            "security": {
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["fix-verification", "regression", "challenge"]
              }
            }
          },
          "required": ["bugfix", "feature", "refactor", "docs", "chore", "security"],
          "additionalProperties": false
        },
        "challenge_rounds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "high_impact_paths": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "string",
